# ---------------------------------------------------------
# Lamees - environment
# ---------------------------------------------------------
#
# Copy to .env and fill in. Everything NEXT_PUBLIC_* is bundled
# into the browser build and is therefore public - never put a
# secret behind that prefix.

# --- Couriers -------------------------------------------------
# Server-only, like the Gmail values below. No NEXT_PUBLIC_
# prefix on any of them: these move real money on COD orders,
# and a prefixed variable is published in the JavaScript bundle.
#
# Leopards is the only courier with an adapter. PostEx and M&P
# appear in the couriers table but booking them returns 501
# until their field specifications are available.
LEOPARDS_API_KEY=
LEOPARDS_API_PASSWORD=

# The account's own pickup city. 'self' uses whatever the
# Leopards account is registered to.
LEOPARDS_ORIGIN_CITY=self

# CONFIRM THESE against your Leopards integration document
# before going live. The host is public; the paths are not, so
# they are configuration rather than something hard-coded as if
# it had been verified.
LEOPARDS_BASE_URL=https://merchantapi.leopardscourier.com
LEOPARDS_BOOK_PATH=/api/bookPacket/format/json/
LEOPARDS_TRACK_PATH=/api/trackBookedPacket/format/json/
LEOPARDS_CITIES_PATH=/api/getAllCities/format/json/

# --- PostEx --------------------------------------------------
# Merchant API v4.1.9. Note the auth header is `token`, not
# `Authorization: Bearer` - most write-ups get that wrong.
POSTEX_API_TOKEN=

# Optional. Which of your pickup addresses to collect from;
# fetch the codes from /v1/get-merchant-address.
POSTEX_PICKUP_ADDRESS_CODE=

POSTEX_BASE_URL=https://api.postex.pk/services/integration/api/order

# --- Order confirmation email --------------------------------
# Gmail with an App Password, not the account password. Turn on
# 2-Step Verification, then Google Account > Security > App
# passwords, and paste the 16 characters here (spaces are fine
# to remove). A normal password will be rejected by Gmail.
#
# No NEXT_PUBLIC_ prefix on either: these are read only by
# /api/orders/confirmation, on the server. Prefixing them would
# publish your mailbox credentials in the JavaScript bundle.
#
# Leave both blank and the shop still takes orders - the route
# logs that mail is not configured and returns without sending.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional. Gets a bcc of every confirmation, so the shop has
# its own copy of what the customer was told.
ORDER_NOTIFICATION_EMAIL=

# --- Supabase -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site -----------------------------------------------------
# Canonical origin, no trailing slash. Every canonical URL, Open
# Graph tag and sitemap entry is built from this, so a staging
# deploy left pointing at production tells Google the two are
# the same site.
NEXT_PUBLIC_SITE_URL=https://lameesofficial.com

# --- Store contact --------------------------------------------
# Used by the WhatsApp button, the contact page, the footer and
# the legal pages.

# Digits only: country code, no "+". This is what wa.me expects.
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

NEXT_PUBLIC_STORE_PHONE=+92 300 123 4567
NEXT_PUBLIC_STORE_EMAIL=info@lamees.com.pk

# "|" separates the lines the footer prints. Everywhere the
# address appears in a sentence it is joined back with commas.
NEXT_PUBLIC_STORE_ADDRESS=123 Fashion Street|Karachi, Pakistan

NEXT_PUBLIC_STORE_HOURS=Monday to Saturday, 10am - 8pm (PKT)

# --- Social profiles ------------------------------------------
# Full profile URLs. Leave one blank and its icon is left out of
# the footer, rather than linking to the platform's homepage.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
